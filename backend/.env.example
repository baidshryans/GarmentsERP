# Copy this file to `.env` and fill in the values.
#   cp .env.example .env   (macOS/Linux)
#   copy .env.example .env (Windows)
#
# Only SECRET_KEY is strictly required. Everything else has a safe default
# in settings.py. The main database is SQLite (db.sqlite3) — no DB creds needed.

# ---- Core ----
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Set True for local development. When False, HTTPS redirect + HSTS turn on
# (breaks `runserver`, which only serves HTTP).
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# In production (DEBUG=False) whitelist the frontend origins:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ---- AI features (optional — leave blank to disable) ----
OPENAI_API_KEY=
# AI_NL_MODEL=gpt-4o-mini
# AI_VISION_MODEL=gpt-4o

# ---- Legacy MySQL sync (optional — only for barcode/legacy import) ----
MYSQL_SYNC_HOST=127.0.0.1
MYSQL_SYNC_PORT=3306
MYSQL_SYNC_USER=root
MYSQL_SYNC_PASSWORD=
MYSQL_SYNC_DB=

# ---- Production overrides (usually leave unset in dev) ----
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# CACHE_BACKEND=redis
# REDIS_URL=redis://127.0.0.1:6379/1
# TIME_ZONE=Asia/Kolkata
